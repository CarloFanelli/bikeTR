# Rifiuta ogni nome host diverso da localhost / 127.0.0.1: una pagina web che fa
# puntare il proprio dominio a 127.0.0.1 (DNS rebinding) non deve leggere l'app.
server {
    listen 80 default_server;
    return 403;
}

server {
    listen 80;
    server_name localhost 127.0.0.1;

    root /usr/share/nginx/html;
    index index.html;

    # DNS di Docker, interrogato a ogni richiesta: nginx parte anche quando un
    # servizio a cui inoltra è spento, e lo ritrova dopo un riavvio.
    resolver 127.0.0.11 valid=10s;

    # sendfile può servire contenuti vecchi dai bind mount di Docker Desktop.
    sendfile off;

    # Il browser riconvalida ogni file: una modifica si vede con un normale reload.
    add_header Cache-Control "no-cache" always;

    # La cartella del progetto è la radice web: mai servire i file nascosti
    # (.env, .git, .ai) né la configurazione Docker.
    location ~ /\. {
        return 404;
    }

    location ^~ /docker/ {
        return 404;
    }

    # Il Coach parla con Ollama da qui: stessa origine dell'app, niente CORS.
    location /ollama/ {
        set $ollama_upstream ${OLLAMA_URL};
        rewrite ^/ollama/(.*)$ /$1 break;
        proxy_pass $ollama_upstream;
        # Ollama rifiuta le origini browser che non conosce.
        proxy_set_header Origin "";
        # La risposta arriva tutta a fine generazione, che su CPU dura minuti:
        # attendere più del limite di 3 minuti del Coach.
        proxy_read_timeout 300s;
    }

    # Login Strava e token di accesso: il server di autenticazione tiene i segreti,
    # il browser riceve solo token di accesso a breve durata.
    location /auth/ {
        set $auth_upstream http://auth:8080;
        proxy_pass $auth_upstream;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
