# Any host name other than localhost / 127.0.0.1 is refused: a web page that
# points its own domain at 127.0.0.1 (DNS rebinding) must not read this app.
server {
    listen 80 default_server;
    return 403;
}

server {
    listen 80;
    server_name localhost 127.0.0.1;

    root /usr/share/nginx/html;
    index index.html;

    # sendfile can serve stale file content from bind mounts on Docker Desktop.
    sendfile off;

    # The browser revalidates every file, so an edit shows on a normal reload.
    add_header Cache-Control "no-cache" always;

    # The repository is mounted as the web root: never serve dotfiles
    # (.env, .git, .ai) or the Docker configuration.
    location ~ /\. {
        return 404;
    }

    location ^~ /docker/ {
        return 404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
