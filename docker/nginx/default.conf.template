# Rifiuta ogni nome host diverso da localhost / 127.0.0.1: una pagina web che fa
# puntare il proprio dominio a 127.0.0.1 (DNS rebinding) non deve leggere l'app.
server {
    listen 80 default_server;
    return 403;
}

# Connessione del live reload: una WebSocket, che nginx inoltra solo se la richiesta
# lo chiede (intestazione Upgrade).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name localhost 127.0.0.1;

    # DNS di Docker, interrogato a ogni richiesta: nginx parte anche quando un
    # servizio a cui inoltra è spento, e lo ritrova dopo un riavvio.
    resolver 127.0.0.11 valid=10s;

    # Indice dei paper: l'unico file della cartella del progetto servito da nginx,
    # scaricato dal Coach service a ogni richiesta.
    location = /papers_index.json {
        root /usr/share/nginx/html;
        # sendfile può servire contenuti vecchi dai bind mount di Docker Desktop.
        sendfile off;
        # Si riconvalida sempre: un indice modificato vale dalla richiesta successiva.
        add_header Cache-Control "no-cache" always;
    }

    # Login Strava e token di accesso: il server di autenticazione tiene i segreti,
    # il browser riceve solo token di accesso a breve durata.
    location /auth/ {
        set $auth_upstream http://auth:8080;
        proxy_pass $auth_upstream;
    }

    # La sezione Coach AI dell'app ha lo stesso nome del servizio: senza questa regola nginx
    # rimanderebbe /coach a /coach/, cioè al servizio, aprendo o ricaricando la sezione.
    location = /coach {
        set $app_upstream http://app:5173;
        proxy_pass $app_upstream;
        proxy_set_header Host $host;
    }

    # Servizio Coach: conosce l'indirizzo di Ollama scritto in .env.
    location /coach/ {
        set $coach_upstream http://coach:8080;
        proxy_pass $coach_upstream;
        # Il workout arriva a eventi (passi, testo del modello): inoltrarli subito,
        # senza aspettare di riempire un buffer.
        proxy_buffering off;
        # Su CPU il modello può tacere per minuti prima della prima parola: attendere
        # più dei 3 minuti di silenzio che il servizio concede a Ollama.
        proxy_read_timeout 300s;
    }

    # Vecchia pagina di dettaglio (segnalibri, schede aperte): il dettaglio dentro l'app.
    # L'id finisce nell'indirizzo di arrivo solo se è fatto di cifre; altrimenti Home.
    location = /activity.html {
        # Indirizzo relativo: nel container nginx ascolta sulla 80, non sulla porta del browser.
        absolute_redirect off;
        if ($arg_id ~ "^[0-9]+$") {
            return 302 "/attivita/$arg_id";
        }
        return 302 /;
    }

    # L'app: il server di sviluppo Vite, che vede solo la cartella web/.
    location / {
        set $app_upstream http://app:5173;
        proxy_pass $app_upstream;
        # Vite risponde solo ai nomi host localhost e 127.0.0.1: riceve quello del browser, non app:5173.
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # La WebSocket del live reload resta aperta anche quando non cambia nulla:
        # chiuderla dopo il minuto predefinito farebbe ricaricare la pagina.
        proxy_read_timeout 1d;
    }
}
