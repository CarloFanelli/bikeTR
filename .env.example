# Impostazioni di BikeTR. Copia questo file in .env e cambia solo ciò che ti
# serve: ogni impostazione è facoltativa e, se manca, vale il valore scritto qui.

# Porta dell'indirizzo dell'app, http://localhost:5050.
# I dati dell'atleta stanno sul server e restano; tema, ultima scheda di Analisi,
# vista di Attività e cache degli stream dell'export sono del browser, per indirizzo:
# dopo aver cambiato porta ripartono da capo.
WEB_PORT=5050

# Porta di Phoenix, che mostra le tracce del Coach: http://localhost:6006.
# Cambiala se un altro programma usa già la 6006, poi esegui `docker compose up -d`.
PHOENIX_PORT=6006

# Credenziali della tua app Strava, da https://www.strava.com/settings/api (come
# "Authorization Callback Domain" scrivi localhost). Senza queste due righe l'app
# si apre ma non si collega a Strava. Restano nel server di autenticazione dentro
# Docker: il browser non le vede mai. Dopo averle scritte o cambiate, esegui di
# nuovo `docker compose up -d`.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Password del database delle attività (servizio db). Il database non è raggiungibile
# da fuori Docker; cambiala prima del primo `docker compose up`: dopo, il database
# esistente tiene la vecchia password finché non lo cancelli con `docker compose down -v`.
POSTGRES_PASSWORD=biketr

# Modello chat del Coach in Ollama: all'avvio Docker lo scarica se manca (circa
# 5 GB la prima volta). I paper si cercano con un piccolo modello dentro il
# servizio Coach, installato con lui: Ollama non serve per la ricerca.
OLLAMA_CHAT_MODEL=qwen2.5:7b

# Chi scrive la risposta del Coach: ollama (se la riga manca) oppure cloud, cioè
# un modello raggiunto con il formato compatibile con OpenAI, per esempio Claude.
# Con cloud servono tutte le sei righe CLOUD_ qui sotto, e i numeri dell'atleta
# elencati nel README (sezione 5) vanno al provider; con Ollama restano sul
# computer. La chiave resta nel servizio Coach: il browser non la vede mai.
# Con cloud Ollama non serve: togli il # anche da OLLAMA_CONTAINERS=0 (in fondo).
# Dopo un cambio esegui `docker compose up -d`.
# COACH_PROVIDER=cloud
# CLOUD_URL=https://api.anthropic.com/v1/
# CLOUD_API_KEY=
# Il nome del modello come lo scrive il provider, per esempio claude-sonnet-5-5.
# CLOUD_MODEL=
# Prezzi del modello in dollari per milione di token letti (IN) e scritti (OUT),
# dalla pagina dei prezzi del provider, con il punto per i decimali (per esempio
# 2 e 10 per claude-sonnet-5-5 a novembre 2026). Ogni risposta mostra il suo costo.
# CLOUD_SPENDING_LIMIT è il massimo da spendere, in dollari: raggiunto il tetto, le
# richieste cloud si fermano finché non lo alzi. Il totale speso resta nei dati del
# Coach anche dopo "Disconnetti da Strava": solo `docker compose down -v` lo cancella.
# CLOUD_PRICE_IN=
# CLOUD_PRICE_OUT=
# CLOUD_SPENDING_LIMIT=

# Senza Ollama in Docker: con un modello cloud togli il # solo da OLLAMA_CONTAINERS=0,
# così Docker non avvia Ollama e non scarica il suo modello. Per usare un Ollama
# installato su questo computer togli il # da entrambe le righe; i modelli vanno
# scaricati sul computer con `ollama pull <nome>`. Poi esegui `docker compose up -d`.
# OLLAMA_CONTAINERS=0
# OLLAMA_URL=http://host.docker.internal:11434
