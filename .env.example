# Impostazioni di BikeTR. Copia questo file in .env e cambia solo ciò che ti
# serve: ogni impostazione è facoltativa e, se manca, vale il valore scritto qui.

# Porta dell'indirizzo dell'app, http://localhost:5050.
# I dati salvati nel browser appartengono a un solo indirizzo: dopo aver
# cambiato porta, il browser non mostra i dati salvati con quella vecchia.
WEB_PORT=5050

# Credenziali della tua app Strava, da https://www.strava.com/settings/api (come
# "Authorization Callback Domain" scrivi localhost). Senza queste due righe l'app
# si apre ma non si collega a Strava. Restano nel server di autenticazione dentro
# Docker: il browser non le vede mai. Dopo averle scritte o cambiate, esegui di
# nuovo `docker compose up -d`.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Modelli AI del Coach: all'avvio Docker scarica quelli che mancano (circa 5 GB
# la prima volta). Se cambi il modello chat, scrivilo anche nelle impostazioni
# del Coach nell'app. L'indice dei paper è costruito con nomic-embed-text:
# cambia il modello embedding solo insieme a un indice ricostruito.
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Per usare un Ollama installato su questo computer invece di quello in Docker:
# togli il # dalle due righe qui sotto ed esegui di nuovo `docker compose up -d`.
# I modelli vanno scaricati sul computer con `ollama pull <nome>`.
# OLLAMA_CONTAINERS=0
# OLLAMA_URL=http://host.docker.internal:11434
